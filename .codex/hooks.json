{
  "description": "Log Codex prompts for AI20K",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "log-prompt",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/scripts/log_hook.py\" --tool=codex",
            "commandWindows": "cmd /c scripts\\_pyrun.cmd scripts\\log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "log-stop",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/scripts/log_hook.py\" --tool=codex",
            "commandWindows": "cmd /c scripts\\_pyrun.cmd scripts\\log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}