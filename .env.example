# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7

# ---- Video Analysis Provider ----
# Supported pairs only:
#   openai + timestamped_frames
#   qwen + native_video
VLM_PROVIDER=openai
VLM_INPUT_MODE=timestamped_frames
OPENAI_VLM_MODEL_NAME=gpt-5.6-luna
DASHSCOPE_API_KEY=
QWEN_VLM_MODEL_NAME=qwen3-vl-flash
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Optional for videos over 7 MB; map this public URL to ARTIFACT_DIR.
QWEN_ARTIFACT_URL_BASE=
QWEN_BASE64_MAX_VIDEO_BYTES=7000000
QWEN_VIDEO_FPS=2
QWEN_ENABLE_THINKING=false
QWEN_THINKING_BUDGET=500
VLM_TIMEOUT_S=120
VLM_STRUCTURED_OUTPUT_RETRIES=0
PROVIDER_NETWORK_RETRIES=0
PROVIDER_REQUEST_LIMIT_PER_INCIDENT=12
VLM_TEMPERATURE=0

# Native video normalization
VLM_VIDEO_TARGET_WIDTH=512
VLM_VIDEO_TARGET_HEIGHT=288
VLM_VIDEO_TARGET_FPS=15
VLM_VIDEO_RESIZE_MODE=fit_pad
VLM_VIDEO_CODEC=libx264
VLM_VIDEO_PIXEL_FORMAT=yuv420p
VLM_VIDEO_MAX_OUTPUT_BYTES=100000000

# Timestamped frames and rolling fallback
VLM_FRAME_FPS=8
VLM_FRAME_WIDTH=512
VLM_FRAME_HEIGHT=288
VLM_FRAME_FORMAT=jpeg
VLM_FRAME_JPEG_QUALITY=85
VLM_MAX_FRAMES=120
VLM_MAX_FRAMES_PER_REQUEST=120
VLM_REANALYSIS_FRAME_FPS=4
VLM_REANALYSIS_MAX_FRAMES=60
VLM_FRAME_OVERFLOW_STRATEGY=rolling_batches
VLM_FRAME_BATCH_SIZE=60
VLM_FRAME_BATCH_OVERLAP=5
VLM_FRAME_MAX_BATCHES=8
VIDEO_MEMORY_MAX_TIMELINE_EVENTS=6
VIDEO_MEMORY_MAX_CLAIMS=100

# Prompt and downstream model settings
VIDEO_ANALYSIS_PROMPT_VERSION=v1
REANALYSIS_PROMPT_VERSION=v1
VERIFICATION_PROMPT_VERSION=v1
REPORTING_PROMPT_VERSION=v1
VERIFICATION_MODEL_NAME=gpt-4o-mini
VERIFICATION_TIMEOUT_S=60
VERIFICATION_TEMPERATURE=0
REPORT_MODEL_NAME=gpt-4o-mini
REPORT_TIMEOUT_S=60
REPORT_TEMPERATURE=0
# Set false to keep contradicted claims in the report without an automatic VLM retry.
AUTO_REANALYSIS_ENABLED=false

# Workflow limits and storage
HUMAN_PROMPT_MAX_LENGTH=5000
INCIDENT_MAX_LOG_BYTES=25000000
INCIDENT_INPUT_ROOTS=./data_mock
INCIDENT_UPLOAD_DIR=./data/uploads
INCIDENT_MAX_DURATION_S=60
INCIDENT_CLIP_MIN_DURATION_S=5
INCIDENT_CLIP_PRE_ROLL_S=1
INCIDENT_CLIP_POST_ROLL_S=2
LOG_TIMESTAMP_TOLERANCE_S=0.5
LOG_CLAIM_SAMPLE_RADIUS=3
LOG_BRAKE_RISE_THRESHOLD=0.3
LOG_STEERING_CHANGE_THRESHOLD=10
ARTIFACT_DIR=./data/artifacts
INCIDENT_DATABASE_PATH=./data/incident_reports.sqlite3
INCIDENT_CHECKPOINT_PATH=./data/incident_checkpoints.sqlite3
INCIDENT_ARTIFACT_RETENTION_HOURS=168
MODEL_ACTIVITY_RETENTION_HOURS=168
MODEL_ACTIVITY_MAX_PER_INCIDENT=100
BACKGROUND_CONCURRENCY=2

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith Tracing ----
# Tracing is optional and never changes workflow routing or outputs.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Phat hien tai nan"
# Required only when the API key belongs to multiple workspaces.
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TRACING_SAMPLING_RATE=1.0

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your_ai_log_api_key_here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
