# ============================================
# AI20K Project — Environment Variables
# ============================================
# NEVER commit this file to git.
#
# Every key here maps to a field on `Settings` in src/config.py, which holds the
# defaults. A key with no matching field is silently ignored (extra="ignore"),
# so adding one here alone does nothing — add the field in config.py first.
# Only keep a line below when you actually want to override the default.

# ---- LLM (verification, reporting, and the eval judge) ----
# OpenAI credential. Never used for video analysis; that is DashScope's job.
OPENAI_API_KEY=
MODEL_NAME=gpt-5.6-luna
# Sampling temperature for that judge; higher means less repeatable answers.
LLM_TEMPERATURE=0.7

# ---- Video analysis (Qwen native video via DashScope) ----
# DashScope credential. Required for any real video analysis.
DASHSCOPE_API_KEY=
# Qwen model id for analysis and focused re-analysis.
# NOTE: config.py defaults to qwen3-vl-flash; this overrides it with the pricier
# plus tier. Confirm the id exists on your DashScope account.
QWEN_VLM_MODEL_NAME=qwen3.7-plus
# DashScope OpenAI-compatible endpoint.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Public URL mapped onto ARTIFACT_DIR. Needed only for videos too large to inline
# as Base64; blank keeps every upload on this machine.
QWEN_ARTIFACT_URL_BASE=
# Videos at or below this size are inlined as a Base64 data URL. Larger ones
# require QWEN_ARTIFACT_URL_BASE or analysis fails.
QWEN_BASE64_MAX_VIDEO_BYTES=7000000
# Frame rate Qwen samples the video at on its side. Higher costs more tokens.
QWEN_VIDEO_FPS=5
# Qwen extended reasoning: slower and more expensive per call.
QWEN_ENABLE_THINKING=true
# Token ceiling for that reasoning.
QWEN_THINKING_BUDGET=1000
# Per-request deadline for any VLM call.
VLM_TIMEOUT_S=120
# Retries when the model returns JSON failing schema validation.
VLM_STRUCTURED_OUTPUT_RETRIES=1
# Retries for transport-level provider failures.
PROVIDER_NETWORK_RETRIES=1
# Hard ceiling on provider calls per incident; the cost circuit breaker.
PROVIDER_REQUEST_LIMIT_PER_INCIDENT=16

# ---- Native video preprocessing (before upload) ----
# Resolution the source is resized and padded to before being sent.
VLM_VIDEO_TARGET_WIDTH=512
VLM_VIDEO_TARGET_HEIGHT=288
# Normalized frame rate, so timestamps mean the same across sources.
VLM_VIDEO_TARGET_FPS=10
# Preserves aspect ratio and pads the rest instead of stretching.
VLM_VIDEO_RESIZE_MODE=fit_pad
# FFmpeg encoder settings for the normalized copy.
VLM_VIDEO_CODEC=libx264
VLM_VIDEO_PIXEL_FORMAT=yuv420p
# Ceiling on the normalized file. Without QWEN_ARTIFACT_URL_BASE the runtime
# uses min(this, QWEN_BASE64_MAX_VIDEO_BYTES).
VLM_VIDEO_MAX_OUTPUT_BYTES=100000000
# Blurs faces and licence plates locally before anything leaves this machine.
# WARNING: currently false, so unredacted footage is sent to DashScope.
# Turn this on before handling real footage or deploying.
VIDEO_REDACTION_ENABLED=true
# YOLO inference resolution for that redaction pass; lower is faster, misses more.
REDACTION_IMAGE_SIZE=512

# ---- Frame artifacts used to canonicalize Qwen timestamps after analysis ----
# Size and quality of the stills each claim and timeline event is pinned to.
VLM_FRAME_WIDTH=512
VLM_FRAME_HEIGHT=288
VLM_FRAME_FORMAT=jpeg
VLM_FRAME_JPEG_QUALITY=85
# Sampling density and cap for the focused clip during re-analysis.
VLM_REANALYSIS_FRAME_FPS=4
VLM_REANALYSIS_MAX_FRAMES=60
# Upper bounds the model output must respect; anything beyond is rejected.
VIDEO_MEMORY_MAX_TIMELINE_EVENTS=6
VIDEO_MEMORY_MAX_CLAIMS=100

# ---- Prompt and downstream model settings ----
# Labels stamped onto PromptEnvelope for traceability. They do NOT select a
# different prompt: nothing in src/prompts branches on version.
VIDEO_ANALYSIS_PROMPT_VERSION=v2
REANALYSIS_PROMPT_VERSION=v2
VERIFICATION_PROMPT_VERSION=v2
REPORTING_PROMPT_VERSION=v2
# Model that checks each claim against the vehicle log.
# NOTE: config.py defaults to gpt-4o-mini; confirm this id exists on your account.
VERIFICATION_MODEL_NAME=gpt-5.6-luna
VERIFICATION_TIMEOUT_S=60
# Keep at 0 so verification is reproducible.
VERIFICATION_TEMPERATURE=0
# Model that writes the narrative sections of the report. Same caveat as above.
REPORT_MODEL_NAME=gpt-5.6-luna
REPORT_TIMEOUT_S=60
REPORT_TEMPERATURE=0
# When a claim contradicts the log, re-ask the VLM once on a focused clip.
# Set false to surface the contradiction without spending another call.
AUTO_REANALYSIS_ENABLED=true

# ---- Workflow limits and storage ----
# Log rows kept each side of the nearest sample; 3 yields at most 7 rows.
# NOTE: config.py defaults to 3 and the README documents 3. At 48 this sends up
# to 97 rows per claim into the verification prompt.
LOG_CLAIM_SAMPLE_RADIUS=48
# How far from a claim's timestamp a log row may sit and still count.
LOG_TIMESTAMP_TOLERANCE_S=0.5
# Longest analyst instruction accepted on incident creation.
HUMAN_PROMPT_MAX_LENGTH=5000
# Largest accepted telemetry CSV. Video size is not capped here.
INCIDENT_MAX_LOG_BYTES=25000000
# Comma-separated directories inputs may be read from. This is the path
# traversal boundary; INCIDENT_UPLOAD_DIR is always added to it.
INCIDENT_INPUT_ROOTS=./data_mock
# Where multipart uploads land.
INCIDENT_UPLOAD_DIR=./data/uploads
# Videos longer than this are rejected before any provider call.
INCIDENT_MAX_DURATION_S=60
# Shape of the incident clip cut for the reviewer: a floor on total length,
# plus lead-in and lead-out around the window the VLM identified.
INCIDENT_CLIP_MIN_DURATION_S=5
INCIDENT_CLIP_PRE_ROLL_S=1
INCIDENT_CLIP_POST_ROLL_S=2
# Generated media: normalized video, clips, frames, charts.
ARTIFACT_DIR=./data/artifacts
# Terminal reports (approved / not_incident).
INCIDENT_DATABASE_PATH=./data/incident_reports.sqlite3
# LangGraph checkpoints backing resume and human review.
INCIDENT_CHECKPOINT_PATH=./data/incident_checkpoints.sqlite3

# ---- App Config ----
# Deployment profile. Setting this to production makes the app refuse to boot
# without OPENAI_API_KEY and DASHSCOPE_API_KEY.
APP_ENV=development
# Comma-separated browser origin allowlist for CORS. Narrow this before deploying.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith Tracing ----
# Tracing is optional and never changes workflow routing or outputs.
# Master switch; everything below is inert while this is false.
LANGSMITH_TRACING=true
# LangSmith API host. Change only for a self-hosted instance.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LangSmith credential; tracing stays off when blank.
LANGSMITH_API_KEY=
# Project name traces are grouped under in the LangSmith UI.
LANGSMITH_PROJECT="Phat hien tai nan"
# Required only when the API key belongs to multiple workspaces.
LANGSMITH_WORKSPACE_ID=
# Fraction of runs traced: 1.0 traces every run, 0.1 traces one in ten.
LANGSMITH_TRACING_SAMPLING_RATE=1.0

# ---- Logging ----
# Minimum severity kept when logging is configured.
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
# Read by scripts/log_hook.py through os.environ, NOT by src/config.py.
# Intentionally not Settings fields, so the guard test allowlists these three.
# Ingest endpoint the hook posts to.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
# Credential for that endpoint.
AI_LOG_API_KEY=ai20k_-c3qwxyCr3IbDA2oKBrW_qegV0qFMC8p
# Local directory the hook mirrors its payloads into.
AI_LOG_DIR=.ai-log
