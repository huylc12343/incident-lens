# ============================================
# AI20K Project — Environment Variables
# ============================================
# NEVER commit this file to git.
#
# Every key here maps to a field on `Settings` in src/config.py, which holds the
# defaults. A key with no matching field is silently ignored (extra="ignore"),
# so adding one here alone does nothing — add the field in config.py first.
# Only keep a line below when you actually want to override the default.

# ---- LLM (verification, reporting, and the eval judge) ----
# OpenAI credential. Never used for video analysis; that is DashScope's job.
OPENAI_API_KEY=
# Model behind src/services/llm.py, used only by the eval semantic judge.
MODEL_NAME=gpt-5.6-luna
# Sampling temperature for that judge; higher means less repeatable answers.
LLM_TEMPERATURE=0.7

# ---- Video analysis (Qwen native video via DashScope) ----
# DashScope credential. Required for any real video analysis.
DASHSCOPE_API_KEY=
# Qwen model id for analysis and focused re-analysis.
# Keep this aligned with the validated runtime default in src/config.py.
QWEN_VLM_MODEL_NAME=qwen3-vl-flash
# DashScope OpenAI-compatible endpoint.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Public URL mapped onto ARTIFACT_DIR. Needed only for videos too large to inline
# as Base64; blank keeps every upload on this machine.
QWEN_ARTIFACT_URL_BASE=
# Videos at or below this size are inlined as a Base64 data URL. Larger ones
# require QWEN_ARTIFACT_URL_BASE or analysis fails.
QWEN_BASE64_MAX_VIDEO_BYTES=7000000
# Frame rate Qwen samples the video at on its side. Higher costs more tokens.
QWEN_VIDEO_FPS=2.0
# Qwen extended reasoning: slower and more expensive per call.
QWEN_ENABLE_THINKING=false
# Token ceiling for that reasoning.
QWEN_THINKING_BUDGET=500
# Per-request deadline for any VLM call.
VLM_TIMEOUT_S=120
# Retries when the model returns JSON failing schema validation.
VLM_STRUCTURED_OUTPUT_RETRIES=0
# Retries for transport-level provider failures.
PROVIDER_NETWORK_RETRIES=0
# Hard ceiling on provider calls per incident; the cost circuit breaker.
PROVIDER_REQUEST_LIMIT_PER_INCIDENT=12

# ---- Native video preprocessing (before upload) ----
# Resolution the source is resized and padded to before being sent.
VLM_VIDEO_TARGET_WIDTH=1280
VLM_VIDEO_TARGET_HEIGHT=720
# Normalized frame rate, so timestamps mean the same across sources.
VLM_VIDEO_TARGET_FPS=15.0
# Preserves aspect ratio and pads the rest instead of stretching.
VLM_VIDEO_RESIZE_MODE=fit_pad
# FFmpeg encoder settings for the normalized copy.
VLM_VIDEO_CODEC=libx264
VLM_VIDEO_PIXEL_FORMAT=yuv420p
# Ceiling on the normalized file. Without QWEN_ARTIFACT_URL_BASE the runtime
# uses min(this, QWEN_BASE64_MAX_VIDEO_BYTES).
VLM_VIDEO_MAX_OUTPUT_BYTES=100000000
# Blurs faces and licence plates locally before anything leaves this machine.
